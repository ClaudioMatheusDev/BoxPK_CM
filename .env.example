# Copie para .env e ajuste os valores. Nunca versione o .env real.
SA_PASSWORD=TroqueEstaSenhaForte123!
# Mínimo de 32 caracteres
Jwt__Key=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres
VITE_API_BASE_URL=http://localhost:5236

# Opcionais
ASPNETCORE_ENVIRONMENT=Development
ALLOW_REGISTRATION=true
CORS_ORIGIN=http://localhost:5173

# Seeds: cria o usuário administrador padrão e popula a plataforma com dados de demonstração
# (catálogo de cartas Pokémon, coleções, fornecedores, compras e estoque). Idempotente.
SEED_DATABASE=true
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@boxtcg.local
# Precisa atender à política do Identity: 6+ caracteres, maiúscula, minúscula, número e símbolo
SEED_ADMIN_PASSWORD=TroqueEstaSenha@123
